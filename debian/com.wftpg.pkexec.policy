<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>WFTPG</vendor>
  <vendor_url>https://github.com/wftpg/wftpg</vendor_url>
  <icon_name>wftpg</icon_name>
  
  <action id="com.wftpg.pkexec">
    <description>Run WFTPG as root</description>
    <description xml:lang="zh_CN">以root权限运行WFTPG</description>
    <message>Authentication is required to run WFTPG Server Manager</message>
    <message xml:lang="zh_CN">需要认证才能运行WFTPG服务器管理器</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/wftpg</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
