#!/bin/sh
set -e

case "$1" in
    configure)
        update-desktop-database /usr/share/applications 2>/dev/null || true
        update-mime-database /usr/share/mime 2>/dev/null || true
        gtk-update-icon-cache /usr/share/icons/hicolor 2>/dev/null || true
        
        if [ ! -d /etc/wftpg ]; then
            mkdir -p /etc/wftpg
            chmod 755 /etc/wftpg
        fi
        
        if [ ! -d /var/log/wftpg ]; then
            mkdir -p /var/log/wftpg
            chmod 755 /var/log/wftpg
        fi
        
        if [ -f /usr/bin/wftpg-launcher ]; then
            chmod 755 /usr/bin/wftpg-launcher
        fi
        
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        
        echo "WFTPG has been installed successfully."
        echo "You can launch it from the application menu or run 'wftpg' command."
        ;;
    
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
