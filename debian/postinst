#!/bin/bash
# wftpg 安装后脚本（用户态服务模型）
#
# wftpd 以 systemd 用户服务运行，无需 root 权限、无需专用用户。
# 首次登录后由用户自行启用：
#   systemctl --user enable --now wftpd

set -e

case "$1" in
    configure)
        # 刷新桌面环境缓存
        if command -v update-desktop-database &> /dev/null; then
            update-desktop-database -q || true
        fi
        if command -v gtk-update-icon-cache &> /dev/null; then
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2> /dev/null || true
        fi

        echo "WFTPG 安装完成。"
        echo "启用后台服务（以桌面用户运行，无需 root）："
        echo "  systemctl --user enable --now wftpd"
        echo "启动图形管理界面："
        echo "  wftp-gui"
        ;;
esac

exit 0
