#!/bin/sh
# wftpg 卸载后脚本（用户态服务模型）
#
# 各用户的配置与状态位于 ~/.config/wftpd 与 ~/.local/state/wftpd，
# 属于用户数据，包卸载时不做清理（purge 亦不触碰用户主目录）。

set -e

case "$1" in
    remove|purge)
        if command -v update-desktop-database &> /dev/null; then
            update-desktop-database -q || true
        fi
        ;;
esac

exit 0
