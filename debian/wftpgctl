#!/bin/bash
# WFTPG 服务管理工具（用户态服务模型）
#
# wftpd 以 systemd 用户服务运行，本工具是 systemctl --user 的便捷封装，
# 全程无需 root 权限。

set -e

SERVICE_NAME="wftpd"
SCRIPT_NAME="$(basename "$0")"

print_usage() {
    echo "用法：$SCRIPT_NAME {start|stop|restart|status|enable|disable}"
    echo ""
    echo "命令说明:"
    echo "  start    - 启动 $SERVICE_NAME 服务"
    echo "  stop     - 停止 $SERVICE_NAME 服务"
    echo "  restart  - 重启 $SERVICE_NAME 服务"
    echo "  status   - 查看 $SERVICE_NAME 服务状态"
    echo "  enable   - 设置 $SERVICE_NAME 开机自启"
    echo "  disable  - 禁用 $SERVICE_NAME 开机自启"
    echo ""
    echo "示例:"
    echo "  $SCRIPT_NAME start"
    echo "  $SCRIPT_NAME enable"
}

if [ $# -ne 1 ]; then
    print_usage
    exit 1
fi

case "$1" in
    start|stop|restart|status|enable|disable)
        exec systemctl --user "$1" "$SERVICE_NAME"
        ;;
    *)
        echo "错误：未知命令 $1"
        print_usage
        exit 1
        ;;
esac
