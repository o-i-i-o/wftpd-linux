#!/bin/bash
# WFTPG 服务管理工具
# 用于管理 wftpd 后台服务的启动、停止、重启等操作

set -e

SERVICE_NAME="wftpd"
SCRIPT_NAME="$(basename "$0")"

# 颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

print_usage() {
    echo "用法：$SCRIPT_NAME {start|stop|restart|status|enable|disable}"
    echo ""
    echo "命令说明:"
    echo "  start    - 启动 $SERVICE_NAME 服务"
    echo "  stop     - 停止 $SERVICE_NAME 服务"
    echo "  restart  - 重启 $SERVICE_NAME 服务"
    echo "  status   - 查看 $SERVICE_NAME 服务状态"
    echo "  enable   - 设置 $SERVICE_NAME 开机自启"
    echo "  disable  - 禁用 $SERVICE_NAME 开机自启"
    echo ""
    echo "示例:"
    echo "  sudo $SCRIPT_NAME start    # 启动服务"
    echo "  sudo $SCRIPT_NAME restart  # 重启服务"
    echo "  $SCRIPT_NAME status        # 查看状态"
}

check_root() {
    if [ "$EUID" -ne 0 ] && [ "$1" != "status" ]; then
        echo -e "${YELLOW}提示：此操作需要 root 权限，请使用 sudo 运行${NC}"
        echo "例如：sudo $SCRIPT_NAME $1"
        exit 1
    fi
}

do_start() {
    echo -e "${GREEN}正在启动 $SERVICE_NAME 服务...${NC}"
    systemctl start $SERVICE_NAME
    sleep 1
    do_status
}

do_stop() {
    echo -e "${YELLOW}正在停止 $SERVICE_NAME 服务...${NC}"
    systemctl stop $SERVICE_NAME
    sleep 1
    echo -e "${GREEN}服务已停止${NC}"
}

do_restart() {
    echo -e "${GREEN}正在重启 $SERVICE_NAME 服务...${NC}"
    systemctl restart $SERVICE_NAME
    sleep 1
    do_status
}

do_status() {
    systemctl status $SERVICE_NAME --no-pager
}

do_enable() {
    echo -e "${GREEN}正在设置 $SERVICE_NAME 开机自启...${NC}"
    systemctl enable $SERVICE_NAME
    echo -e "${GREEN}开机自启已启用${NC}"
}

do_disable() {
    echo -e "${YELLOW}正在禁用 $SERVICE_NAME 开机自启...${NC}"
    systemctl disable $SERVICE_NAME
    echo -e "${GREEN}开机自启已禁用${NC}"
}

# 主程序
if [ $# -eq 0 ]; then
    print_usage
    exit 1
fi

case "$1" in
    start)
        check_root "$1"
        do_start
        ;;
    stop)
        check_root "$1"
        do_stop
        ;;
    restart)
        check_root "$1"
        do_restart
        ;;
    status)
        do_status
        ;;
    enable)
        check_root "$1"
        do_enable
        ;;
    disable)
        check_root "$1"
        do_disable
        ;;
    help|--help|-h)
        print_usage
        ;;
    *)
        echo -e "${RED}错误：未知命令 '$1'${NC}"
        print_usage
        exit 1
        ;;
esac

exit 0
