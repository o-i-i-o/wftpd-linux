#!/usr/bin/env expect -f

set timeout 20

spawn sftp -P 2222 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null 123@localhost

expect {
    "password:" {
        send "123456\r"
    }
    timeout {
        puts "Timeout waiting for password prompt"
        exit 1
    }
}

expect {
    "sftp>" {
        send "pwd\r"
    }
    timeout {
        puts "Timeout waiting for sftp prompt"
        exit 1
    }
}

expect {
    "sftp>" {
        send "ls -la\r"
    }
    timeout {
        puts "Timeout after pwd command"
        exit 1
    }
}

expect {
    "sftp>" {
        send "exit\r"
    }
    timeout {
        puts "Timeout after ls command"
        exit 1
    }
}

expect eof
